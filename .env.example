# Copy this file to ".env" and adjust.

# Port the app listens on.
PORT=3000

# Public address of the app (no trailing slash). Needed for Google login/Calendar.
# Not needed on Render (it is detected automatically).
APP_URL=http://localhost:3000

# Database
# - Leave TURSO_* empty to use a local SQLite file in DATA_DIR (good for running on your own PC).
# - Set them to use a free Turso cloud database (required on Render).
DATA_DIR=./data
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google OAuth (optional, free). See README section "Google Calendar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
