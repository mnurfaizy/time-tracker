{
  "manifest_version": 3,
  "name": "Time Tracker",
  "version": "1.1.0",
  "description": "Start and stop your Time Tracker timer from the browser toolbar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Time Tracker",
    "default_icon": {
      "16": "icons/icon-idle-16.png",
      "32": "icons/icon-idle-32.png",
      "48": "icons/icon-idle-48.png",
      "128": "icons/icon-idle-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["__SERVER_ORIGIN__/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Open Time Tracker"
    },
    "toggle-timer": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start / stop the timer"
    }
  }
}
